# Copy to .env (setup.sh does) and fill in. .env is never committed.
# Gemini API key, for stage 4 (https://aistudio.google.com/apikey).
GEMINI_API_KEY=your-gemini-api-key
# Gemini model of stage 4. Pinned: the scores in the README were measured with it; another model changes the output.
GEMINI_MODEL=gemini-3.8-flash
# Most Gemini calls ever made for one document (one call per page with a table).
GEMINI_CAP=100
# Optional: lock file that other jobs on a shared GPU take with flock. Leave empty on a GPU of your own.
GPU_LOCK=
# Optional speed settings; leave empty for the defaults, which were measured on VIC (architecture_design.md, 5).
# Stage 1 processes (default: a third of the CPU threads). Raise it when the box OCR ends well after MinerU.
PREP_JOBS=
# Pages MinerU reads at once (default 1). More is faster but MinerU's reads then change from run to run.
MINERU_JOBS=
# Gemini calls in flight (default 8).
GEMINI_JOBS=
